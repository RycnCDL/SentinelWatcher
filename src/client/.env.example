# Local development settings for the Vite dev server. Copy to .env if you need to change them.
# Sign-in settings (client ID, tenant ID) are NOT configured here: the client loads them
# at runtime from the API's /config.json endpoint.

# URL of the local API that the dev server proxies /api and /config.json to.
# Default: http://localhost:5000 (matches src/api/Properties/launchSettings.json).
# SW_API_URL=http://localhost:5000
