// Local development settings.
// Copy this file to appsettings.Development.json in the same folder (that file is gitignored)
// and replace the placeholders. dotnet run uses the Development environment, so it is loaded
// on top of appsettings.json. No secrets go in here.
{
  "AzureAd": {
    // Values printed by scripts/setup-app-registration.sh:
    // Directory (tenant) ID and Application (client) ID of the SentinelWatcher app registration.
    "TenantId": "<tenant-id>",
    "ClientId": "<client-id>"
  },
  "Sentinel": {
    // Leave empty for local development: DefaultAzureCredential then uses your az login.
    // In Azure, set this to the client ID of the user-assigned managed identity.
    "ManagedIdentityClientId": "",

    // Allow-list of Log Analytics workspace resource IDs the app may read. Find the ID in the
    // Azure portal (workspace, Properties, Resource ID) or with:
    //   az monitor log-analytics workspace show -g <resource-group> -n <workspace-name> --query id -o tsv
    "Workspaces": [
      "/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.OperationalInsights/workspaces/<workspace-name>"
    ],

    // Data Collection Rules page. Set to false to hide it; the identity then needs no
    // access to data collection rules.
    "EnableDcrPage": true
  },
  "ConnectorHealth": {
    // A connector is Warning or Error when its newest record is older than these (minutes).
    "WarningAfterMinutes": 60,
    "ErrorAfterMinutes": 120,
    // Overrides per connector type, merged with the built-in defaults. EventDriven connectors
    // become Quiet instead of Warning or Error. Example:
    // "Connectors": { "Syslog": { "WarningAfterMinutes": 240, "ErrorAfterMinutes": 480 } }
    "Connectors": {}
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
