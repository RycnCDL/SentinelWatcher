{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-client-id>",
    "ClientSecret": "<your-client-secret>"
  },
  "CacheSettings": {
    "HeavyQueryRefreshMinutes": 10,
    "ConnectorGapThresholdMinutes": 60,
    "CostPerGBDollars": 2.76
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://your-domain.com"
    ]
  }
}
