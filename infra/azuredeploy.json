{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "17551191722775225815"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the app resources. Defaults to the resource group location."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "[format('sentinelwatcher-{0}', uniqueString(resourceGroup().id))]",
      "minLength": 2,
      "maxLength": 50,
      "metadata": {
        "description": "Web app name. It becomes https://<appName>.azurewebsites.net, which must be a redirect URI of the app registration."
      }
    },
    "appServicePlanSku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "B2",
        "B3",
        "S1",
        "S2",
        "S3",
        "P0v3",
        "P1v3",
        "P2v3",
        "P3v3"
      ],
      "metadata": {
        "description": "App Service plan SKU (Linux)."
      }
    },
    "entraTenantId": {
      "type": "string",
      "defaultValue": "[tenant().tenantId]",
      "metadata": {
        "description": "Directory (tenant) ID of the SentinelWatcher app registration. Defaults to the tenant of this deployment."
      }
    },
    "entraClientId": {
      "type": "string",
      "metadata": {
        "description": "Application (client) ID of the SentinelWatcher app registration, printed by scripts/setup-app-registration.sh."
      }
    },
    "workspaceResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the Log Analytics workspace with Microsoft Sentinel: /subscriptions/{id}/resourceGroups/{rg}/providers/Microsoft.OperationalInsights/workspaces/{name}."
      }
    },
    "enableDcrPage": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Show the Data Collection Rules page. When false, no DCR role is assigned."
      }
    },
    "dcrRole": {
      "type": "string",
      "defaultValue": "CustomRole",
      "allowedValues": [
        "CustomRole",
        "MonitoringReader"
      ],
      "metadata": {
        "description": "How the identity reads data collection rules when the DCR page is on. CustomRole grants only Microsoft.Insights/dataCollectionRules/read. MonitoringReader is a fallback for environments where custom roles are not allowed; it can read all monitoring data and settings in the resource group."
      }
    },
    "packageUrl": {
      "type": "string",
      "defaultValue": "https://github.com/RycnCDL/SentinelWatcher/releases/latest/download/sentinelwatcher.zip",
      "metadata": {
        "description": "URL of the release package (zip) to run from. Leave empty to deploy a package yourself with az webapp deploy."
      }
    },
    "enableApplicationInsights": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Create Application Insights (with its own small Log Analytics workspace) for app telemetry."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags applied to all resources created by this template."
      }
    }
  },
  "variables": {
    "workspaceIdParts": "[split(parameters('workspaceResourceId'), '/')]",
    "workspaceSubscriptionId": "[variables('workspaceIdParts')[2]]",
    "workspaceResourceGroup": "[variables('workspaceIdParts')[4]]",
    "dcrAccess": "[if(parameters('enableDcrPage'), parameters('dcrRole'), 'None')]",
    "packageSettings": "[if(empty(parameters('packageUrl')), createArray(), createArray(createObject('name', 'WEBSITE_RUN_FROM_PACKAGE', 'value', parameters('packageUrl'))))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('id-{0}', parameters('appName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "condition": "[parameters('enableApplicationInsights')]",
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('log-{0}', parameters('appName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "condition": "[parameters('enableApplicationInsights')]",
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[format('appi-{0}', parameters('appName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('appName')))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('appName')))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-04-01",
      "name": "[format('asp-{0}', parameters('appName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('appServicePlanSku')]"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "app,linux",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName'))))]": {}
        }
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('asp-{0}', parameters('appName')))]",
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "siteConfig": {
          "linuxFxVersion": "DOTNETCORE|10.0",
          "appCommandLine": "dotnet SentinelWatcher.Api.dll",
          "alwaysOn": true,
          "http20Enabled": true,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "scmMinTlsVersion": "1.2",
          "appSettings": "[concat(createArray(createObject('name', 'AzureAd__Instance', 'value', environment().authentication.loginEndpoint), createObject('name', 'AzureAd__TenantId', 'value', parameters('entraTenantId')), createObject('name', 'AzureAd__ClientId', 'value', parameters('entraClientId')), createObject('name', 'Sentinel__ManagedIdentityClientId', 'value', reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName'))), '2023-01-31').clientId), createObject('name', 'Sentinel__Workspaces__0', 'value', parameters('workspaceResourceId')), createObject('name', 'Sentinel__EnableDcrPage', 'value', string(parameters('enableDcrPage')))), variables('packageSettings'), if(parameters('enableApplicationInsights'), createArray(createObject('name', 'APPLICATIONINSIGHTS_CONNECTION_STRING', 'value', reference(resourceId('Microsoft.Insights/components', format('appi-{0}', parameters('appName'))), '2020-02-02').ConnectionString)), createArray()))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', format('appi-{0}', parameters('appName')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName')))]",
        "[resourceId('Microsoft.Web/serverfarms', format('asp-{0}', parameters('appName')))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2024-04-01",
      "name": "[format('{0}/{1}', parameters('appName'), 'ftp')]",
      "properties": {
        "allow": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2024-04-01",
      "name": "[format('{0}/{1}', parameters('appName'), 'scm')]",
      "properties": {
        "allow": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('sentinelwatcher-workspace-access-{0}', uniqueString(parameters('appName')))]",
      "subscriptionId": "[variables('workspaceSubscriptionId')]",
      "resourceGroup": "[variables('workspaceResourceGroup')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "principalId": {
            "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName'))), '2023-01-31').principalId]"
          },
          "dcrAccess": {
            "value": "[variables('dcrAccess')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "98756719399377603"
            }
          },
          "parameters": {
            "principalId": {
              "type": "string",
              "metadata": {
                "description": "Principal (object) ID of the user-assigned managed identity."
              }
            },
            "dcrAccess": {
              "type": "string",
              "allowedValues": [
                "CustomRole",
                "MonitoringReader",
                "None"
              ],
              "metadata": {
                "description": "How the identity reads data collection rules: CustomRole (only Microsoft.Insights/dataCollectionRules/read), MonitoringReader (built-in fallback), or None (DCR page turned off)."
              }
            }
          },
          "variables": {
            "sentinelReaderRoleId": "8d289c81-5878-46d4-8554-54e1e3d8b5cb",
            "monitoringReaderRoleId": "43d0d8ad-25c7-4714-9337-8ba259a9fe05",
            "dcrReaderRoleGuid": "[guid(resourceGroup().id, 'SentinelWatcher DCR Reader')]",
            "dcrRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', if(equals(parameters('dcrAccess'), 'CustomRole'), variables('dcrReaderRoleGuid'), variables('monitoringReaderRoleId')))]"
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, parameters('principalId'), variables('sentinelReaderRoleId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('sentinelReaderRoleId'))]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal",
                "description": "SentinelWatcher: read Microsoft Sentinel configuration and query the workspace"
              }
            },
            {
              "condition": "[equals(parameters('dcrAccess'), 'CustomRole')]",
              "type": "Microsoft.Authorization/roleDefinitions",
              "apiVersion": "2022-04-01",
              "name": "[variables('dcrReaderRoleGuid')]",
              "properties": {
                "roleName": "[format('SentinelWatcher DCR Reader {0}', uniqueString(resourceGroup().id))]",
                "description": "Read data collection rules. Used by SentinelWatcher for its Data Collection Rules page.",
                "type": "CustomRole",
                "permissions": [
                  {
                    "actions": [
                      "Microsoft.Insights/dataCollectionRules/read"
                    ],
                    "notActions": [],
                    "dataActions": [],
                    "notDataActions": []
                  }
                ],
                "assignableScopes": [
                  "[resourceGroup().id]"
                ]
              }
            },
            {
              "condition": "[not(equals(parameters('dcrAccess'), 'None'))]",
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, parameters('principalId'), 'SentinelWatcher DCR access', parameters('dcrAccess'))]",
              "properties": {
                "roleDefinitionId": "[variables('dcrRoleDefinitionId')]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal",
                "description": "SentinelWatcher: read data collection rules for the Data Collection Rules page"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Authorization/roleDefinitions', variables('dcrReaderRoleGuid'))]"
              ]
            }
          ],
          "outputs": {
            "dcrRoleDefinitionId": {
              "type": "string",
              "value": "[if(equals(parameters('dcrAccess'), 'None'), '', variables('dcrRoleDefinitionId'))]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName')))]"
      ]
    }
  ],
  "outputs": {
    "appUrl": {
      "type": "string",
      "metadata": {
        "description": "URL of the app. Add it as a SPA redirect URI of the app registration."
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2024-04-01').defaultHostName)]"
    },
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the web app, for az webapp deploy and az webapp log tail."
      },
      "value": "[parameters('appName')]"
    },
    "managedIdentityClientId": {
      "type": "string",
      "metadata": {
        "description": "Client ID of the managed identity the app uses for all Azure calls."
      },
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName'))), '2023-01-31').clientId]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the managed identity. Use it to list its role assignments."
      },
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('appName'))), '2023-01-31').principalId]"
    },
    "dcrAccess": {
      "type": "string",
      "metadata": {
        "description": "Data collection rule access that was assigned: CustomRole, MonitoringReader or None."
      },
      "value": "[variables('dcrAccess')]"
    }
  }
}